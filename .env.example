# NOTE: nothing in this repository reads this file. The extension does not use
# environment variables (it is plain JS, no bundler). Settings and API keys are
# entered in the side panel and stored in chrome.storage.local.
# This file is only a reminder of the values you will be asked for.

# Local Antigravity Bridge (default port 8765; set in the side panel settings)
BRIDGE_URL=http://127.0.0.1:8765

# Optional TinyFish key (entered in the side panel; never commit a real key)
TINYFISH_API_KEY=tf_your_key_here
