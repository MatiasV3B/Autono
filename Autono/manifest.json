{
  "manifest_version": 3,
  "name": "Autono",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "incognito": "not_allowed",
  "description": "Autonomous AI browser agent and navigation copilot with Chat & Cowork modes, connected to local Antigravity Bridge (Gemini 3.8, Claude).",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_icon": "assets/icon-32.png",
    "default_title": "Open Autono"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "windows": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "Open Autono"
    },
    "summon_mascot": {
      "suggested_key": {
        "default": "Alt+Shift+1"
      },
      "description": "Call the Autono mascot (quick /btw question)"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "side-panel/index.html"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabGroups",
    "unlimitedStorage",
    "sidePanel",
    "power",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:*/*",
    "http://localhost:*/*"
  ],
  "options_page": "options/options.html",
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'; frame-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' http://127.0.0.1:* http://localhost:* http://[::1]:* https:"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/mascot/*.gif"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
