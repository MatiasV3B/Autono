  "description": "Autono - Autonomous AI Browser Agent & Navigation Copilot (Gemini 3.8, Claude)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-dist.js",
